# Project
!/.gitignore
!/README.md
!/RELEASE_NOTES.md
!/LICENSE
!/pubspec.yaml
!/pubspec.lock
!/analysis_options.yaml
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.yml
!/.github/workflows/*.yml

# Icon sources (the launcher, status bar and splash icons are made from these)
!/images/**

# App
!/lib/**
!/test/**
!/scripts/**
!/assets/fonts/**
!/assets/icons/**
!/assets/dns/
!/assets/dns/**

# Android
!/android/build.gradle.kts
!/android/settings.gradle.kts
!/android/gradle.properties
!/android/gradle/wrapper/gradle-wrapper.properties
!/android/app/build.gradle.kts
!/android/app/src/main/AndroidManifest.xml
!/android/app/src/debug/AndroidManifest.xml
!/android/app/src/profile/AndroidManifest.xml
!/android/app/src/main/kotlin/**
!/android/app/src/test/kotlin/**
!/android/app/src/main/res/**
!/android/app/src/main/assets/psiphon_config.json

# Native helpers
!/psiphon/**
!/core/**
/core/.bin/
/core/bpbcore

# Worker
!/worker/worker.js
!/worker/package.json

# Windows (the Flutter desktop runner; its build/ dir stays ignored)
!/windows/**
/windows/flutter/ephemeral/
/windows/build/

# The installer script
!/installer/**
/installer/Output/

# Assets generated at build time by the scripts and the CI
/assets/tor/
/android/app/src/main/assets/geoip.dat
/android/app/src/main/assets/geosite.dat
worker/worker.min.js
core/build/

# The setup-Tor bundle staged locally for the integration test (CI downloads its own).
core/tor/
